# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Warehouses and bulky generated artefacts
*.duckdb
*.duckdb.wal
*.parquet
dist/

# Raw source binaries (re-downloadable). Provenance files are committed.
data/raw/**/*.pdf
data/raw/**/*.PDF
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.zip
data/raw/**/*.csv
# Fetched web pages used as profile sources (news, statements). They can carry personal
# information, so they stay out of git; the manifest row (URL, sha256, fetch time) is committed.
data/raw/profile-sources/

# OS
.DS_Store
.popia-names.local

# Collector TLS/certificate error evidence (source, URL, error). Not committed.
data/raw/**/tls-errors.jsonl
data/raw/tls-errors.jsonl
